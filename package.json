{
  "name": "deckterm",
  "version": "0.1.62",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5199 && cross-env DECKTERM_DEV=1 electron . --remote-debugging-port=9333\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "typecheck": "tsc --noEmit",
    "install-hooks": "node scripts/install-hooks.mjs",
    "icon": "electron scripts/icon.mjs",
    "brand": "node scripts/brand-sheet.mjs",
    "site": "vite --config site/vite.config.mts",
    "site:build": "vite build --config site/vite.config.mts",
    "site:deploy": "npm run site:build && node scripts/deploy-site.mjs",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make --arch arm64",
    "release": "node scripts/release.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron/rebuild": "^4.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dockview-react": "^8.4.1",
    "electron": "^44.7.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.55.0",
    "motion": "13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "productName": "Own Term",
  "description": "A macOS terminal for working with Claude Code",
  "config": {
    "forge": "./forge.config.cjs"
  }
}
